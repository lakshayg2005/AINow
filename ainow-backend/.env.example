# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- core
# Local Postgres:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ainow
# A hosted Postgres (Neon, Supabase, ...) — use its pooled connection
# string if it offers one, and keep sslmode=require:
#   DATABASE_URL=postgresql+psycopg://user:password@host/db?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ainow
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Public URLs (used in email links and CORS). Set these to the
# deployed frontend/backend addresses in production.
FRONTEND_URL=http://localhost:5173
API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- email
# Brevo (recommended for production: free 300/day, doesn't touch a
# personal inbox) is used automatically when BREVO_API_KEY is set;
# Gmail SMTP is the fallback otherwise. The sender address must be
# verified in Brevo's dashboard first (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
EMAIL_FROM=AINow <you@example.com>

# Gmail SMTP (used only when BREVO_API_KEY is unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
# Pause between newsletter emails (Gmail throttles bursts)
EMAIL_SEND_INTERVAL_SECONDS=1.0

# ---------------------------------------------------------------- free LLM providers
# Any provider with a key is tried in order: groq, cerebras,
# gemini, openrouter, hf, ollama. Groq's free tier is the
# recommended default (console.groq.com).
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen3-8B
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: pin exact provider:model chains
# LLM_FAST_CHAIN=groq:openai/gpt-oss-20b,hf:Qwen/Qwen3-8B
# LLM_STRONG_CHAIN=groq:openai/gpt-oss-120b

# ---------------------------------------------------------------- sources
# Optional; raises GitHub search rate limits
GITHUB_TOKEN=

# ---------------------------------------------------------------- scheduler
# Runs inside the API process; only works on a single always-on
# worker. On a free host that sleeps when idle, leave this off and
# use the scheduled GitHub Actions workflow instead
# (.github/workflows/pipeline.yml), which wakes the host itself.
SCHEDULER_ENABLED=false
INGEST_EVERY_HOURS=6
# 0 = Monday ... 6 = Sunday (UTC)
COMPOSE_WEEKDAY=6
COMPOSE_HOUR_UTC=6
# false = drafts wait for review in /admin before sending
AUTO_PUBLISH=false
